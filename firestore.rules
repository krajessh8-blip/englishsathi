rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // No one can list all schools - only if you know the UDISE
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if false; // only your backend server.ts can write via Admin SDK / secure function
    }
    match /schools/{schoolId}/{sub=**} {
      allow read, write: if request.auth != null;
    }
    
    // Students/Teachers - only logged in user of that school
    match /students/{id} {
      allow read, write: if request.auth != null && request.auth.token.udise == resource.data.udiseCode;
    }
    
    // Pending + Index - NO client access at all
    match /pendingSchools/{id} { allow read, write: if false; }
    match /udiseIndex/{id} { allow read, write: if false; }
    match /audit-logs/{id} { allow read: if false; allow write: if request.auth != null; }
    match /admin-security-audit/{id} { allow read, write: if false; }

    // Default deny
    match /{document=**} { allow read, write: if false; }
  }
}
